# Backend URL is server-only. No provider or admin secrets belong in public variables.
AWAAZ_API_URL=http://127.0.0.1:8000
SITE_URL=http://localhost:3000
# Existing voice application, served by FastAPI. Configure a public HTTPS URL on deployment.
ASSISTANT_URL=/assistant/
# Optional business email/phone: omit until real approved contact details are available.
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_WHATSAPP=
SERVICE_CITY=
SERVICE_AREA=

# Invited agency marketplace rollout; enable only after staging acceptance.
MARKETPLACE_ENABLED=false
CUSTOMER_FEATURES_ENABLED=false
MAP_ENABLED=false
PUBLIC_WEBSITE_URL=http://localhost:3000
NEXT_PUBLIC_MAP_ENABLED=false
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Development-only legacy token tools are hidden by default.
AWAAZ_DEV_STAFF_TOOLS=false
