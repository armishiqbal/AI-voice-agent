APP_ENV=development
# Development default; set PostgreSQL in staging/production.
DATABASE_URL=sqlite:///./awaaz-dev.db
ADMIN_API_KEY=
# Required in staging/production; use a random secret with at least 32 bytes.
VOICE_SESSION_HMAC_KEY=
# Required outside development; set to inference capacity before deployment.
VOICE_SESSION_MAX_ACTIVE_PER_CLIENT=2
VOICE_SESSION_LEASE_SECONDS=90
# Only proxy IPs/CIDRs you operate; never use '*'.
TRUSTED_PROXY_IPS=127.0.0.1,::1
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-live-transcribe
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
DEEPGRAM_API_KEY=
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro
FISH_AUDIO_REFERENCE_ID=
FISH_AUDIO_SAMPLE_RATE=24000
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE=default
EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=5
TTS_PROVIDER=router
TTS_PARLER_SERVICE_URL=
TTS_CHATTERBOX_SERVICE_URL=
TTS_SERVICE_TOKEN=
TTS_TIMEOUT_SECONDS=60
TTS_URDU_MODEL=facebook/mms-tts-urd-script_latin
TTS_ENGLISH_MODEL=facebook/mms-tts-eng
TTS_HINDI_MODEL=facebook/mms-tts-hin
TTS_ARABIC_MODEL=facebook/mms-tts-ara
TTS_PUNJABI_MODEL=facebook/mms-tts-pan
TTS_BENGALI_MODEL=facebook/mms-tts-ben
LOCAL_TTS_ENABLED=false
STT_PROVIDER=deepgram
STT_MODEL=nova-3
STT_LANGUAGE=multi
STT_SAMPLE_RATE=16000
STT_ENDPOINTING_MS=300
STT_UTTERANCE_END_MS=1000
STT_MIN_CONFIDENCE=0.55
VOICE_MAX_AUDIO_FRAME_BYTES=16384
VOICE_AUDIO_QUEUE_FRAMES=256
VOICE_MAX_EVENT_BYTES=8192
VOICE_MAX_WS_MESSAGE_BYTES=32768
VOICE_WS_PROTOCOL_QUEUE=16
TELEPHONY_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TELEPHONY_PUBLIC_BASE_URL=
# Download this OAuth client JSON from Google Cloud into the ignored secrets/ directory.
GOOGLE_TOKEN_PATH=./secrets/google.token.json
GOOGLE_CLIENT_SECRET_PATH=./secrets/client_secret.json
GOOGLE_CALENDAR_ID=primary
GMAIL_SENDER=
OUTBOX_POLL_SECONDS=1.0
OUTBOX_MAX_ATTEMPTS=8
MAX_UPLOAD_BYTES=10000000
PII_ENCRYPTION_KEY=

# Vector knowledge store: pinecone (managed) or faiss (single-process local).
RAG_PROVIDER=pinecone
RAG_LOCAL_PATH=artifacts/knowledge/faiss.json
# Assigned employee name -> email; trusted operator configuration, JSON.
EMPLOYEE_EMAIL_DIRECTORY={}
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TOKEN=
# Local Compose services; use strong secrets. Pin N8N_IMAGE before deployment.
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=

# Experimental concurrent clause synthesis; enable only after provider latency checks.
VOICE_EARLY_CLAUSE_STREAMING_ENABLED=false
VOICE_EMOTION_MATCHING_ENABLED=true

# Recover to listening if synthesis never starts or stops producing audio.
VOICE_TTS_FIRST_AUDIO_TIMEOUT_SECONDS=12
VOICE_TTS_IDLE_TIMEOUT_SECONDS=8
